DATABASE_URL="file:./dev.db"

# Optional server-side fallback key, only used when a request has no per-user
# key (see "APIキー設定" in the UI). Leave empty on a shared/public deployment
# so every user is required to bring their own key. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: force a specific model instead of the built-in try-in-order list in
# src/lib/gemini.ts. Google frequently rotates which models are available to
# new API keys, so set this if you hit a 404 "no longer available" error and
# don't want to wait for a code change. Check current IDs at
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=""

# Web Push (VAPID). Generate your own pair with `npx web-push generate-vapid-keys`.
# The public key is intentionally also exposed to the browser (NEXT_PUBLIC_*).
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Shared secret required in the "x-cron-secret" header to call POST /api/feed/refresh.
# Leave empty in local dev (the endpoint stays open); set a real value in production.
CRON_SECRET=""

# Signing secret for login session cookies (JWT/HS256). Generate your own with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Rotating it instantly logs out every existing session.
AUTH_SECRET=""

# Set to "false" to disable the built-in in-process auto-refresh timer (see src/instrumentation.ts).
ENABLE_AUTO_FEED_CRON="true"
# Hours between automatic feed refreshes (in-process timer, self-hosted/long-running deployments only).
FEED_REFRESH_INTERVAL_HOURS="3"

# Sentry error tracking. Same DSN for both - NEXT_PUBLIC_SENTRY_DSN is bundled
# into the browser, SENTRY_DSN is used server/edge-side. Get a DSN at
# https://sentry.io (Settings > Projects > <project> > Client Keys).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Org/project slugs and an auth token are only needed to upload source maps at
# build time (Settings > Auth Tokens, needs the project:releases scope).
# Leave unset locally - uploads are silently skipped and stack traces just
# show minified code.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
