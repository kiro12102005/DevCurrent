# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma sqlite (local dev db, not committed)
/prisma/*.db
/prisma/*.db-journal

# pwa generated service worker files
/public/sw.js
/public/workbox-*.js
/public/sw.js.map
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/fallback-*.js
/public/fallback-*.js.map

# pnpm local store
/.pnpm-store

# local Claude Code session state (permissions, scheduled task locks)
/.claude/

# personal interview-prep notes, not for the public repo
/docs/INTERVIEW_PREP.md
