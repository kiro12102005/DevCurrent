// Tech Trend Catchup - DB schema (PostgreSQL / Supabase)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Content ingestion -------------------------------------------------

// One row per source URL (Qiita/Zenn/Hacker News/ArXiv article, or user-submitted URL).
// This is the cache key that prevents duplicate Gemini calls for the same content.
model Article {
  id          String   @id @default(cuid())
  url         String   @unique
  urlHash     String   @unique // sha256(normalized url) - fast indexed lookup / cache key
  title       String?
  sourceType  SourceType @default(USER_SUBMITTED)
  rawText     String?    // scraped article body, trimmed
  contentHash String?    // sha256(rawText) - detects if source content changed since last fetch
  language    String?    // "ja" | "en" | "zh"
  sourcePublishedAt DateTime? // publish date reported by the source (Qiita/Zenn/HN/ArXiv), for feed sorting
  country           String?   // best-guess origin country (Qiita/Zenn: always Japan; others: Gemini-inferred from title/content)
  engagementScore   Int?      // normalized popularity signal from the source (likes/points/stocks) at crawl time
  isFeatured        Boolean   @default(false) // top picks from a refresh cycle - these get auto-summarized + push notified
  tags              String[]  @default([]) // cheap keyword-derived topic tags (see lib/tags.ts) - no extra Gemini cost, used for interest-based filtering
  fetchedAt   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  generation  AIGeneration?
  userNotes   UserNote[]
  userStates  UserArticleState[]

  @@index([sourceType])
  @@index([sourcePublishedAt])
  @@index([isFeatured])
  @@index([tags], type: Gin)
}

enum SourceType {
  QIITA
  ZENN
  HACKER_NEWS
  ARXIV
  AI_TOOL_PICK
  USER_SUBMITTED
}

// Cached Gemini output for an Article. 1:1 with Article - this IS the cache layer:
// once generated for a given contentHash, we never regenerate for the same article.
model AIGeneration {
  id               String   @id @default(cuid())
  articleId        String   @unique
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  summary          String   // in-depth plain-language summary
  prosAndCons      String   // JSON string: { pros: string[], cons: string[], outlook: string }
  glossary         String   // JSON string: { term: string, explanation: string }[]

  modelUsed        String   @default("gemini-2.5-flash")
  promptTokens     Int?
  outputTokens     Int?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// --- User space ----------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  interestTags     String[] @default([]) // opt-in topic filter for personalized push (see lib/tags.ts for the fixed tag list)
  stackKeywords    String[] @default([]) // freeform specific technologies (e.g. "React", "PyTorch") - matched by title substring, same personalized-push path as interestTags but not limited to the fixed category list
  wantsWeeklyDigest Boolean @default(false) // opt-in - Resend digest email is off by default

  // Independently toggleable push notification channels (both default on -
  // interestTags/stackKeywords above only ever narrow WHICH articles trigger
  // the featured-pick channel, they don't turn a whole channel off).
  wantsFeaturedPush       Boolean @default(true) // general "found new featured picks" notifications
  wantsBreakingChangePush Boolean @default(true) // breaking-change alerts - independent of interestTags/stackKeywords, since "something you use might break" is high-signal regardless of topic interest

  shareSlug      String?  @unique // random public identifier for the opt-in shareable achievement page (/u/[shareSlug]) - null until the user opts in, deliberately NOT the user id
  publicNickname String?  // shown on the public share page instead of email; null = shown as "ユーザー"

  notes             UserNote[]
  pushSubscriptions PushSubscription[]
  articleStates     UserArticleState[]
  toolBookmarks     UserToolBookmark[]
}

// Per-user read/bookmark state for an article. One row per (user, article) pair -
// created lazily on first interaction, not backfilled for every article up front.
model UserArticleState {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  isRead       Boolean  @default(false)
  isBookmarked Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

// Freeform memo / interview-prep note a user attaches to an article.
model UserNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([articleId])
}

// --- Push notifications ----------------------------------------------------

// One row per subscribed browser (Web Push). Devices can still self-register
// anonymously (userId null); logging in on a device attaches it to the
// account so notifications and unsubscribe-everywhere work per-user.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- Curated picks (populated by src/lib/curation/aiToolPicks.ts) --------

model AiToolPick {
  id             String    @id @default(cuid())
  name           String    @unique // e.g. "Gemini Gem", "Claude Fable" - unique so re-running curation upserts instead of duplicating
  category       String    // "AIサービス" | "iOSアプリ" | "PC機能" | "開発支援ツール" | "ブラウザ拡張"
  summary        String
  recommendedFor String    // "who should use this"
  useCaseExample String
  sourceUrl      String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  bookmarks      UserToolBookmark[]

  @@index([category])
}

// Per-user bookmark on an AI tool pick - curation re-runs upsert by name
// (see aiToolPicks.ts), so without this a tool a user liked could feel like
// it "disappeared" once a later refresh cycle didn't happen to resurface it.
model UserToolBookmark {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId    String
  tool      AiToolPick @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, toolId])
  @@index([userId])
}

// --- Podcast digest (Gemini multi-speaker TTS) ----------------------------

// One row per day's generated episode - shared/operator-funded content (like
// AiToolPick), not per-user. Audio itself lives in Vercel Blob; this just
// tracks the URL + the script Gemini generated so it doesn't need
// regenerating if requested again the same day.
model PodcastEpisode {
  id         String   @id @default(cuid())
  date       String   @unique // YYYY-MM-DD (JST) - one episode per day
  audioUrl   String
  script     String // the full dialogue text, also shown as a transcript
  durationSec Int?
  createdAt  DateTime @default(now())
}
